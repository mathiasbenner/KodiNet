@inject IThemeManagementService ThemeMgmtSvc
@inject IDialogService DialogSvc
@inject ISnackbar Snackbar
@inject IStringLocalizer<TabThemes> L

<div class="kn-settings-section">
    <div class="kn-settings-header mb-3">
        <MudText Typo="Typo.h6" Class="kn-page-title">@L["Component_Title"]</MudText>
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                    StartIcon="@Icons.Material.Filled.AddCircleOutline"
                    Size="Size.Small"
                    OnClick="OpenAddTheme">
            @L["ButtonAdd_Label"]
        </MudButton>
    </div>

    @if (Loading)
    {
        <KnLoading Message="@L["Loading_Label"]" />
    }
    else if (!Items.Any())
    {
        <MudAlert Severity="Severity.Info" Dense="true">
            @L["Data_NoEntry"]
        </MudAlert>
    }
    else
    {
        <MudTable Items="Items" FixedHeader="true" Dense="true"
                    Hover="true" Height="80vh" Class="kn-settings-table">
            <HeaderContent>
                <MudTh><MudTableSortLabel SortBy="new Func<AppThemeDto, string>(x => x.Name)">@L["DataRow_Name"]</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortBy="new Func<AppThemeDto, string>(x => x.SwatchColor ?? string.Empty)">@L["DataRow_MainColor"]</MudTableSortLabel></MudTh>
                <MudTh></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>@context.Name</MudTd>
                <MudTd><div style="@($"background-color: {context.SwatchColor}60; outline:4px solid {context.SwatchColor};")">@context.SwatchColor</div></MudTd>
                <MudTd>
                    <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                    Size="Size.Small"
                                    OnClick="@(() => OpenEditTheme(context))" />
                    <MudIconButton Disabled="context.IsSystem" Icon="@Icons.Material.Filled.Delete"
                                    Size="Size.Small" Color="Color.Error"
                                    OnClick="@(() => DeleteTheme(context))" />
                </MudTd>
            </RowTemplate>
        </MudTable>
    }
</div>

@code {
    [Parameter] public IReadOnlyList<AppThemeDto> Items { get; set; } = [];
    [Parameter] public bool Loading { get; set; } = true;
    [Parameter] public EventCallback OnRefresh { get; set; }

    private async Task RefreshAsync()
    {
        if (OnRefresh.HasDelegate) 
            await OnRefresh.InvokeAsync();
    }

    // ── Actions themes ────────────────────────────────────────────────────────
    private async Task OpenAddTheme()
    {
        var p = new DialogParameters { ["Theme"] = (AppThemeDto?)null };
        var d = await DialogSvc.ShowAsync<ThemeFormDialog>(L["DialogAdd_DialogTitle"], p,
                new DialogOptions { MaxWidth = MaxWidth.ExtraSmall, FullWidth = true });
        var r = await d.Result;
        if (r is not null && !r.Canceled) await RefreshAsync();
    }

    private async Task OpenEditTheme(AppThemeDto dto)
    {
        var p = new DialogParameters { ["Theme"] = dto };
        var d = await DialogSvc.ShowAsync<ThemeFormDialog>(L["DialogEdit_DialogTitle"], p,
                new DialogOptions { MaxWidth = MaxWidth.ExtraSmall, FullWidth = true });
        var r = await d.Result;
        if (r is not null && !r.Canceled) await RefreshAsync();
    }

    private async Task DeleteTheme(AppThemeDto dto)
    {
        var ok = await DialogSvc.ShowMessageBoxAsync(L["MessageBoxDelete_Title"],
        string.Format(L["MessageBoxDelete_Message"], dto.Name),
        yesText: L["MessageBoxDelete_Yes"], cancelText: L["MessageBoxDelete_Cancel"]);
        if (ok != true) return;
        try
        {
            await ThemeMgmtSvc.DeleteAsync(dto.Id);
            await RefreshAsync();
            Snackbar.Add(string.Format(L["MessageBoxDeleteSnackbar_Success"], dto.Name), Severity.Success);
        }
        catch (Exception ex) { Snackbar.Add(string.Format(L["MessageBoxDeleteSnackbar_Error"], ex.Message), Severity.Error); }
    }
}