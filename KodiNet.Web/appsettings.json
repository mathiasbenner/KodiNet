{
  "AzureAd": {
    "Instance": "https://login.microsoftonline.com/",
    "TenantId": "YOUR_TENANT_ID",
    "ClientId": "YOUR_CLIENT_ID",
    "ClientSecret": "YOUR_CLIENT_SECRET",
    "CallbackPath": "/signin-oidc"
  },
  "Storage": {
    "BaseUrl": "http://YOUR_STORAGE_SERVER:8090",
    "ApiKey": "YOUR_STORAGE_API_KEY",
    "RootPath": "/videos",
    "MaxSizeMB": 4096
  },
  "ConnectionStrings": {
    "KodinetConnection": "Server=localhost;Port=3306;Database=kodinet;User=kodinet_user;Password=YOUR_DB_PASSWORD;"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "Polling": {
    "StatusIntervalSeconds": 20,
    "ListRefreshIntervalSeconds": 30,
    "PlayerMediaTabIntervalSeconds": 5,
    "MaxConcurrency": 5
  },
  "Localization": {
    "DefaultCulture": "fr"
  },
  "AllowedHosts": "*"
}
